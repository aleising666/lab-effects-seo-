# Copy to .env and fill in. Never commit .env.

# The site to monitor
SITE_URL=https://labeffects.com

# Database. Leave blank to use a local SQLite file (seo.db).
# On Render this is set automatically from the attached Postgres.
DATABASE_URL=

# Google Search Console. Paste the whole service-account JSON key on one line.
# The service account email must be added as a user on the property in
# Search Console (Settings -> Users and permissions).
GSC_SERVICE_ACCOUNT_JSON=
# The property as it appears in Search Console. Domain properties look like
# sc-domain:labeffects.com ; URL-prefix properties look like https://labeffects.com/
GSC_PROPERTY=sc-domain:labeffects.com

# Slack incoming webhook for the report channel
SLACK_WEBHOOK_URL=

# Keyword data provider: none | dataforseo
KEYWORD_PROVIDER=none
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Crawl settings
CRAWL_MAX_PAGES=3000
CRAWL_DELAY_SECONDS=0.5

# Copy to .env and fill in. Never commit .env.

# The site to monitor
SITE_URL=https://labeffects.com

# Database. Leave blank to use a local SQLite file (seo.db).
# On Render this is set automatically from the attached Postgres.
DATABASE_URL=

# Google Search Console. Paste the whole service-account JSON key on one line.
# The service account email must be added as a user on the property in
# Search Console (Settings -> Users and permissions).
GSC_SERVICE_ACCOUNT_JSON=
# The property as it appears in Search Console. Domain properties look like
# sc-domain:labeffects.com ; URL-prefix properties look like https://labeffects.com/
GSC_PROPERTY=sc-domain:labeffects.com

# Slack. Preferred: a bot token (scopes chat:write, files:write; invite the bot
# to the channel) so the PDF report can be uploaded. Channel ID is the C... id
# from the channel URL. Fallback: an incoming webhook (text only, no PDF).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0B1ZM4TASY
SLACK_WEBHOOK_URL=

# Where PDFs are written before upload
REPORT_DIR=reports

# Keyword data provider: none | dataforseo. With dataforseo set, the nightly run
# also pulls rank tracking and backlinks, and competitor gaps once a week.
KEYWORD_PROVIDER=none
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Competitors for the keyword-gap report (comma separated, no https://)
COMPETITORS=trueterpenes.com,abstraxtech.com,floraplexterpenes.com
# Country for rankings and volumes: us | gb | de | au
COUNTRY=us

# Crawl settings
CRAWL_MAX_PAGES=3000
CRAWL_DELAY_SECONDS=0.5
